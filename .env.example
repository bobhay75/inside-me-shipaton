# Public RevenueCat Android SDK key from your RevenueCat project.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Optional Me+U Cloud Run reflection endpoint, for example:
# https://me-u-agent-xxxxx-uc.a.run.app/reflect
# The mobile app works locally if this is blank.
# Keep Gemini and other provider secret keys on the server, never in this app.
EXPO_PUBLIC_REFLECTION_API_URL=
